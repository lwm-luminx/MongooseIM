+domain_admin_room_hats_no_permission_story(Config, Alice) ->
+    [begin
+         RoomJID = jid:from_binary(Room),
+         get_unauthorized(set_room_hat(RoomJID, ?HOST_HAT, <<"Host">>, null, Config)),
