+    escalus:send(Bob, escalus_stanza:to(escalus_stanza:presence(<<"available">>, [FakeHats]),
+                                        BobRoomJID)),
+    [assert_hats(RoomJID, <<"bobek">>, [{?HOST_HAT, <<"Host">>, undefined}], Client)
+     || Client <- [Alice, Bob]].
