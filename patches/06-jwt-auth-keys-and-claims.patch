+claims() ->
+    Now = erlang:system_time(second),
+    #{bookingNumber => ?USERNAME, exp => Now + 60, iat => Now}.
+
+full_claims(Extra) ->
+    maps:merge(claims(), maps:merge(#{iss => <<"https://issuer.example.com">>,
+                                      aud => <<"chat">>,
+                                      domain => ?DOMAIN}, Extra)).
