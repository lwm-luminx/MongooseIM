@@ -263,6 +275,34 @@ user_subscribe_for_messages_with_resource_in_use_story(Config, Bob) ->
     escalus_client:send(Bob, escalus_stanza:chat_to(escalus_client:full_jid(Bob), <<"Hi!">>)),
